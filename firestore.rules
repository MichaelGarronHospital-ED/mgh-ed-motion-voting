rules_version = '2';
// MOTION VOTING RULES. The server-side access boundary for the whole tool.
//
//   • Only two shared Firebase accounts get in at all (emails below, same as
//     js/config.js): ed@ (the ED password, every voter) and leadership@ (the
//     Leadership password, the console). Anyone else reads and writes nothing.
//   • A voter (the ED account) may read everything, and while a motion is open
//     may cast or change a ballot of exactly the shape js/db.js castVote writes,
//     and add exactly one to that motion's voteCount.
//   • Leadership manages motions and settings, with these limits (since the
//     saved-results update, R1): a saved result is never changed; ballots of
//     a closed motion are locked; a motion is deleted only from the Trash (its
//     ballots only after it); re-opening a closed motion needs a change-log
//     entry with a reason, and only once its result is saved; a result is
//     written only to a motion already closed, in its own write; open and
//     close times are the server's (no back-dating).
//   • The change log (log/) is readable and writable by leadership only, and
//     an entry can never be edited.
//   • The voters' board (config/live), past results (config/history) and the
//     other config documents: everyone signed in reads them; only leadership writes.
//
// Publish with:  npx firebase-tools deploy --only firestore:rules
// Test first:    cd tests/rules && npm install && npm test   (Firestore emulator)
// If a publish goes wrong, roll back by republishing the previous version:
// Firebase console > Firestore > Rules shows the history of published rules,
// or `git revert` the change here and deploy again. Never open the database to
// everyone, not even for a minute: the ballots carry names.
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with one of the two shared passwords: the ED password (account
    // ed@…, voters) or the Leadership password (leadership@…). An anonymous or
    // any other account is refused, so the ED password is enforced here, by the
    // server, and not only by the screen. Keep the emails identical to config.js.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email in ['ed@ed-motion-voting.app', 'leadership@ed-motion-voting.app'];
    }
    function isLeader() { return signedIn() && request.auth.token.email == 'leadership@ed-motion-voting.app'; }
    function pollPath(poll) { return /databases/$(database)/documents/polls/$(poll); }
    function pollIsOpen(poll) {
      return get(pollPath(poll)).data.status == 'open';
    }
    // a voter's only allowed poll write: bump voteCount by exactly +1, while open
    function voterBumpsVoteCount(poll) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount'])
        && request.resource.data.voteCount == resource.data.get('voteCount', 0) + 1
        && pollIsOpen(poll);
    }

    // ---- ballots: the exact shape js/db.js castVote writes ----------------
    // A voter can write only these fields, with these types. The ballot lives
    // under its own name (document id == slug), so one name is one ballot.
    function isChoice(c) { return c in ['favour', 'against', 'abstain']; }
    function isSessionId(s) { return s is string && s.size() > 0 && s.size() <= 100; }
    // A new ballot: first tap of a name on this motion. Written in the same
    // transaction as the +1 to the motion's voteCount, which is checked here
    // so a ballot can never land without being counted.
    function isNewBallot(poll, vote) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'slug', 'group', 'weight', 'isWriteIn', 'choice',
                               'sessionIds', 'submissionCount', 'flagged', 'firstAt', 'lastAt'])
        && d.keys().hasAll(['name', 'slug', 'group', 'weight', 'isWriteIn', 'choice',
                            'sessionIds', 'submissionCount', 'flagged', 'firstAt', 'lastAt'])
        && d.slug is string && d.slug == vote
        && d.slug.size() <= 100 && d.slug.matches('[a-z0-9]+(-[a-z0-9]+)*')
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.group is string && d.group.size() <= 20
        && d.weight is number && d.weight >= 0 && d.weight <= 1
        && d.isWriteIn is bool
        && isChoice(d.choice)
        && d.sessionIds is list && d.sessionIds.size() == 1 && isSessionId(d.sessionIds[0])
        && d.submissionCount == 1
        && d.flagged == false
        && d.firstAt == request.time && d.lastAt == request.time
        && getAfter(pollPath(poll)).data.get('voteCount', 0) == get(pollPath(poll)).data.get('voteCount', 0) + 1;
    }
    // A change to an existing ballot (a new choice, or the same name from
    // another device). Name, slug, category and first-vote time stay as they
    // were. Device ids only grow, by at most one new id, and keep every old
    // one; "flagged" is true exactly when 2+ devices have used this name; the
    // submission count goes up by one only when the choice actually changes.
    function isBallotChange(vote) {
      let d = request.resource.data;
      let old = resource.data;
      let oldIds = old.get('sessionIds', []);
      let ids = d.sessionIds;
      return d.diff(old).affectedKeys().hasOnly(['choice', 'submissionCount', 'sessionIds', 'flagged', 'lastAt'])
        && d.slug == vote
        && isChoice(d.choice)
        && ids is list && ids.hasAll(oldIds)
        && (ids.size() == oldIds.size() || ids.size() == oldIds.size() + 1)
        && ids.toSet().size() == ids.size()
        && isSessionId(ids[ids.size() - 1])
        && d.flagged == (ids.size() > 1)
        && d.submissionCount == old.get('submissionCount', 1) + (d.choice != old.get('choice', '') ? 1 : 0)
        && d.lastAt == request.time;
    }

    // ---- motions: saved results (R1) -------------------------------------
    function pollData(poll) { return get(pollPath(poll)).data; }
    function logPath(id) { return /databases/$(database)/documents/log/$(id); }

    function hasResult(d) { return d.get('status', '') == 'closed' && ('result' in d); }
    function resultOk(d) {
      return d.result is map
        && d.result.keys().hasAll(['v', 'kind', 'outcome', 'totalVotes', 'quorumCount',
                                   'quorumNeeded', 'eligible', 'rule', 'savedAt'])
        && d.result.outcome in ['pass', 'fail', 'tie', 'noq', 'decided', 'none', 'noMajority']
        && d.result.savedAt == request.time;
    }
    // A changed time field must be the server's time (no back-dating).
    function timeOk(a, b, f) { return a.get(f, null) == b.get(f, null) || a.get(f, null) == request.time; }
    function metaKeys() { return ['archived', 'deleted', 'meetingId', 'order', 'mover',
                                  'seconder', 'notes', 'number', 'amends']; }
    // A change-log entry created in this same write, about this motion, with one of these actions.
    function newLog(id, poll, actions) {
      return id is string && !exists(logPath(id)) && existsAfter(logPath(id))
        && getAfter(logPath(id)).data.pollId == poll
        && getAfter(logPath(id)).data.action in actions;
    }
    // Closed to open: always logged, only once the result is saved (so the
    // earlier count is never lost), never on a motion already replaced by a
    // re-vote. The saved result moves to priorResults; the frozen categories
    // are dropped so the re-opened vote counts live. The app copies those
    // categories into the reopen log entry's "before".
    function isReopen(poll, ch) {
      let b = resource.data;
      let a = request.resource.data;
      return ('result' in b) && !('supersededBy' in b)
        && ch.hasOnly(['status', 'result', 'priorResults', 'lockedGroups', 'lastLog',
                       'reopenCount', 'archived', 'openedAt'])
        && a.status == 'open' && !('result' in a) && !('lockedGroups' in a)
        && a.get('priorResults', []) == b.get('priorResults', []).concat([b.result])
        && timeOk(a, b, 'openedAt')
        && newLog(a.get('lastLog', ''), poll, ['reopen']);
    }
    // A re-vote or run-off links the original to its replacement (R2): only
    // supersededBy and lastLog change, with a "revote" or "runoff" log entry
    // about the original made in the same write. Offered only once a result is saved.
    function isRevoteLink(poll, ch) {
      return ch.hasOnly(metaKeys().concat(['supersededBy', 'lastLog']))
        && request.resource.data.supersededBy is string
        && newLog(request.resource.data.lastLog, poll, ['revote', 'runoff']);
    }
    function lockedPollUpdate(poll) {          // a saved result exists
      let ch = request.resource.data.diff(resource.data).affectedKeys();
      return ch.hasOnly(metaKeys()) || isReopen(poll, ch) || isRevoteLink(poll, ch);
    }
    function unlockedPollUpdate(poll) {        // draft, open, or closed with no result yet
      let b = resource.data;
      let a = request.resource.data;
      let ch = a.diff(b).affectedKeys();
      return !ch.hasAny(['priorResults', 'supersededBy'])
        // a result only on a motion that was ALREADY closed, in its own write
        && (!('result' in a) || (b.get('status', '') == 'closed' && a.status == 'closed' && resultOk(a)))
        && timeOk(a, b, 'closedAt') && timeOk(a, b, 'openedAt')
        // a motion is closed once: a second close (a new closing time) of a
        // motion already closed is refused, so it can never move the frozen
        // categories or the time its result is checked against
        && !(b.get('status', '') == 'closed' && a.get('status', '') == 'closed' && ch.hasAny(['closedAt', 'closeOfOpenedAt']))
        && !(b.get('status', '') == 'closed' && a.get('status', '') != 'closed' && !isReopen(poll, ch))
        // a close must name the opening it closes, so a close queued offline
        // cannot land on a motion that was re-opened (or opened again) since;
        // old motions with no openedAt compare null == null, so the previous
        // page can still close them
        && !(b.get('status', '') == 'open' && a.get('status', '') == 'closed'
             && a.get('closeOfOpenedAt', null) != b.get('openedAt', null))
        // once voting has started, nothing that changes what people are voting on
        && !(b.get('status', '') == 'open' && b.get('voteCount', 0) > 0
             && ch.hasAny(['kind', 'options', 'optionIds', 'seats', 'threshold', 'rule', 'text']));
    }

    match /polls/{poll} {
      allow read: if signedIn();
      allow create: if isLeader() && request.resource.data.get('status', 'draft') == 'draft'
        && !('result' in request.resource.data) && !('priorResults' in request.resource.data);
      allow delete: if isLeader() && resource.data.get('deleted', false) == true;   // Trash only
      // leadership edits within the limits above; a voter may only +1 the voteCount counter
      allow update: if (isLeader() && (hasResult(resource.data) ? lockedPollUpdate(poll) : unlockedPollUpdate(poll)))
                    || (signedIn() && voterBumpsVoteCount(poll));

      match /votes/{vote} {
        allow read: if signedIn();
        // a voter may only cast/change a ballot while the motion is OPEN, and
        // only in the shape above. Leadership may write ballots until the
        // motion closes; closed ballots are kept with the result.
        allow create: if (isLeader() && pollData(poll).status != 'closed')
                      || (signedIn() && pollIsOpen(poll) && isNewBallot(poll, vote));
        allow update: if (isLeader() && pollData(poll).status != 'closed')
                      || (signedIn() && pollIsOpen(poll) && isBallotChange(vote));
        // closed ballots go only after their motion is permanently deleted
        allow delete: if isLeader() && (!exists(pollPath(poll)) || pollData(poll).status != 'closed');
      }
    }

    // ---- change log: leadership only; entries are never edited -------------
    function logOk(d) {
      return d.keys().hasOnly(['at', 'action', 'pollId', 'meetingId', 'text', 'reason', 'by', 'before', 'after'])
        && d.at == request.time
        && d.action in ['open', 'close', 'catch-up', 'reopen', 'revote', 'runoff', 'archive', 'unarchive',
                        'trash', 'restore', 'purge', 'move', 'settings', 'roster', 'roster-bulk',
                        'writein', 'meeting', 'attendance', 'history-purge']
        && (!('reason' in d) || (d.reason is string && d.reason.size() <= 1000))
        && (!('by' in d) || (d.by is string && d.by.size() <= 80))
        && (!('text' in d) || (d.text is string && d.text.size() <= 300))
        && (!('pollId' in d) || (d.pollId is string && d.pollId.size() <= 100))
        && (!('meetingId' in d) || (d.meetingId is string && d.meetingId.size() <= 100));
    }
    match /log/{id} {
      allow read: if isLeader();
      allow create: if isLeader() && logOk(request.resource.data);
      allow update, delete: if false;
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isLeader();
    }
  }
}

// ---------------------------------------------------------------------------
//  HONEST LIMITS. True today, and deliberate. Pinned here so a change is a
//  decision, not an accident.
//
//  • Every voter signs in as the SAME account (ed@, the ED password), so the
//    rules cannot tell one voter from another. Anyone with the ED password can
//    cast or change the ballot under ANY name while a motion is open, i.e. vote
//    as someone else. The old fix "stamp request.auth.uid on the ballot" no
//    longer works: every voter has the same uid. Preventing it would need a
//    per-person secret (a PIN or a personal sign-in). This is the documented
//    trade-off in CLAUDE.md ("duplicate votes are flagged, not blocked"): the
//    app flags the same name from 2+ devices and one device under 2+ names for
//    leadership review. It holds because voting happens in a room of
//    colleagues, not because the rules prevent it.
//
//  • What the ballot rules DO stop: a second ballot for one name under another
//    document id (the id must equal the slug), a choice other than favour /
//    against / abstain, extra or wrongly typed fields, a ballot that skips the
//    voteCount +1, clearing the device list or the "Needs review" flag by
//    hand, and back-dated times.
//
//  • What they do NOT stop: the device ids are made up by the browser, so a
//    voter who clears site data looks like a new device, and a deliberate one
//    can invent ids. The name, category, weight and write-in mark on a new
//    ballot are the voter's own claim; the tally ignores the stored category
//    and weight (it weighs by slug from roster.js and leadership's settings),
//    but the name shown in the Voters tab is not checked against the slug.
//    A voter can also bump an open motion's voteCount by one on its own
//    (it only drives the edit lock and the purge warning, not any result).
//
//  • Everyone with the ED password can read every ballot, names and choices
//    included. Voting is not secret from the group.
//
//  • The Leadership password is the password of the leadership@ account, so
//    its strength is the strength of every leadership rule here.
//
//  • A saved result is only as good as the ballots it was counted from: the
//    rules freeze the ballots at close and keep the result from changing, but
//    they cannot check the arithmetic the console did.
//
//  • The change log's "by" is a name typed on the console laptop, not checked.
// ---------------------------------------------------------------------------
