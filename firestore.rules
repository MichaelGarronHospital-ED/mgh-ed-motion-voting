rules_version = '2';
// LOCKED RULES — require Firebase Auth. Publish these only AFTER you've:
//   1. Enabled Anonymous + Email/Password sign-in (Firebase → Authentication)
//   2. Created the leadership user (email below + password = your passcode)
//   3. Deployed the latest site and confirmed voting + admin login work
// If anything misbehaves, paste firestore.rules.open instead to revert.
//
//   • Voters sign in anonymously → may read, and create/update their ballots.
//   • Leadership signs in as the email below → may manage motions, categories,
//     adjust/remove votes. Update the email here if your leader email differs.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isLeader() { return signedIn() && request.auth.token.email == 'leadership@ed-motion-voting.app'; }
    function notTouchingWeightOverride() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['weightOverride']);
    }
    function pollIsOpen(poll) {
      return get(/databases/$(database)/documents/polls/$(poll)).data.status == 'open';
    }
    // a voter's only allowed poll write: bump voteCount by exactly +1, while open
    function voterBumpsVoteCount(poll) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount'])
        && request.resource.data.voteCount == resource.data.get('voteCount', 0) + 1
        && pollIsOpen(poll);
    }

    match /polls/{poll} {
      allow read: if signedIn();
      allow create, delete: if isLeader();
      // leadership edits anything; a voter may only +1 the voteCount counter
      allow update: if isLeader() || (signedIn() && voterBumpsVoteCount(poll));

      match /votes/{vote} {
        allow read: if signedIn();
        // a voter may only cast/change a ballot while the motion is OPEN, and
        // may not set the leadership-only weight override; leadership can do
        // anything (incl. delete and post-close cleanup).
        allow create: if isLeader() || (signedIn() && pollIsOpen(poll));
        allow update: if isLeader() || (signedIn() && pollIsOpen(poll) && notTouchingWeightOverride());
        allow delete: if isLeader();
      }
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isLeader();
    }
  }
}
